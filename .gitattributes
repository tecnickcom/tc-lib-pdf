# Normalize text sources to LF in the repository and on checkout everywhere,
# so that the tree is byte-identical across Windows/macOS/Linux checkouts
# regardless of core.autocrlf.
*.php      text eol=lf
*.md       text eol=lf
*.xml      text eol=lf
*.xml.dist text eol=lf
*.json     text eol=lf
*.toml     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.txt      text eol=lf
Makefile   text eol=lf

# Byte-exact fixtures must never be transformed (CRLF/auto-detection off).
*.png binary
*.jpg binary
*.pdf binary
*.z binary

# Keep contributor-only files out of the Packagist dist archive. Files a
# consumer of the package may need (LICENSE, README.md, SECURITY.md) are
# shipped; everything used only when working on the repository is not.
/.editorconfig     export-ignore
/.gitattributes    export-ignore
/.github           export-ignore
/.gitignore        export-ignore
/CODEOWNERS        export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md   export-ignore
/Makefile          export-ignore
/RELEASE           export-ignore
/examples          export-ignore
/mago.examples.toml export-ignore
/mago.src.toml     export-ignore
/mago.test.toml    export-ignore
/phpunit.xml.dist  export-ignore
/resources         export-ignore
/test              export-ignore
